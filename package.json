{
  "name": "pharmafuse-catalog",
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "description": "Normalize and merge pharmacy supplier data into a traceable catalog",
  "private": true,
  "keywords": [
    "pharmacy",
    "catalog",
    "normalization",
    "deduplication",
    "provenance",
    "graphql",
    "nestjs",
    "sqlite",
    "clean-architecture"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d9911/pharmafuse-catalog.git"
  },
  "author": {
    "name": "Denis Gutsuliak",
    "email": "admin@d9911.org",
    "url": "https://t.me/d9911/"
  },
  "contributors": [
    {
      "name": "Denis Gutsuliak",
      "email": "admin@d9911.org",
      "url": "https://t.me/d9911/"
    }
  ],
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/d9911/pharmafuse-catalog/issues"
  },
  "homepage": "https://github.com/d9911/pharmafuse-catalog#readme",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint:code": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"docker/**/*.mjs\" \".github/**/*.yml\" \"*.{json,mjs,yaml,yml}\" \"README*.md\" \"SECURITY.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"docker/**/*.mjs\" \".github/**/*.yml\" \"*.{json,mjs,yaml,yml}\" \"README*.md\" \"SECURITY.md\" \"docs/**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns='spec.ts$' --testPathIgnorePatterns='int-spec|e2e-spec'",
    "test:integration": "jest --runInBand --testPathPatterns='int-spec.ts$'",
    "test:e2e": "node --no-warnings --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "architecture:cycles": "madge --ts-config tsconfig.json --extensions ts --circular src",
    "architecture:graph": "graphify update . --no-cluster",
    "typeorm": "node --require ts-node/register --require tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "verify": "npm run format:check && npm run lint:code && npm run typecheck && npm run test && npm run test:e2e && npm run architecture:cycles && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/graphql": "13.4.2",
    "@nestjs/mercurius": "13.4.2",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/typeorm": "11.0.3",
    "better-sqlite3": "13.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fast-xml-parser": "5.10.1",
    "fastify": "5.12.5",
    "graphql": "17.0.2",
    "mercurius": "16.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "30.4.2",
    "madge": "8.0.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
